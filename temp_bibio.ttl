#################################################################

###  http://www.semanticweb.org/junior/ontologies/2026/0/bibliotheque#Exemplaire_001
bibliotheque:Exemplaire_001 rdf:type owl:NamedIndividual ,
                                     bibliotheque:Exemplaire ;
                            bibliotheque:estUneCopieDe bibliotheque:Les_Miserables ;
                            bibliotheque:codeBarre "BAR001" ;
                            bibliotheque:état "bon" .


###  http://www.semanticweb.org/junior/ontologies/2026/0/bibliotheque#Jean_Dupont
bibliotheque:Jean_Dupont rdf:type owl:NamedIndividual ,
                                  bibliotheque:Utilisateur ;
                         bibliotheque:matricule "U2026-001" ;
                         bibliotheque:nom "Jean Dupont" .


###  http://www.semanticweb.org/junior/ontologies/2026/0/bibliotheque#Les_Miserables
bibliotheque:Les_Miserables rdf:type owl:NamedIndividual ,
                                     bibliotheque:Livre ;
                            bibliotheque:aPourAuteur bibliotheque:Victor_Hugo ;
                            bibliotheque:isbn "978-2-07-036822-8" ;
                            bibliotheque:titre "Les Misérables" .


###  http://www.semanticweb.org/junior/ontologies/2026/0/bibliotheque#Resa_01
bibliotheque:Resa_01 rdf:type owl:NamedIndividual ,
                              bibliotheque:Réservation ;
                     bibliotheque:aPourRéservation bibliotheque:Jean_Dupont ;
                     bibliotheque:porteSur bibliotheque:Les_Miserables ;
                     bibliotheque:dateReservation "2026-01-14T10:00:00"^^xsd:dateTime .


###  http://www.semanticweb.org/junior/ontologies/2026/0/bibliotheque#Victor_Hugo
bibliotheque:Victor_Hugo rdf:type owl:NamedIndividual ,
